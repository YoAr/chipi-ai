OPENAI_API_KEY=
# Our OpenAI project uses US data residency; the default host rejects its calls.
OPENAI_BASE_URL=https://us.api.openai.com/v1
# Model IDs (confirm with: curl -s https://api.openai.com/v1/models -H "Authorization: Bearer $OPENAI_API_KEY")
OPENAI_MODEL_SMART=gpt-6-astra
OPENAI_MODEL_CHECK=gpt-6.1-sol
OPENAI_MODEL_FAST=gpt-6-luna
# Oxylabs Web API (webapi.oxylabs.io: /v1/search for Scout and the Researcher, /v1/scrape as page fallback).
# Key from a Web API instance in the Oxylabs dashboard, sent as a Bearer token. In prod: fly secrets set OXYLABS_WEB_API_KEY=...
OXYLABS_WEB_API_KEY=
RESEND_API_KEY=
# Shared secret the laptop routine sends to /mcp and /api/reset
MCP_TOKEN=
# Comma-separated addresses outreach may be sent to on the demo deploy
EMAIL_ALLOWLIST=
# Where the app reads and writes data (Fly volume mounts at /data)
DATA_DIR=./runtime-data
# 1 = serve fixtures/ instead of real logic (lets the frontend start immediately)
MOCK_MODE=1
